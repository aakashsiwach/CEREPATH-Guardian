# Path to the existing CEREPATH checkout on the machine running Guardian.
CEREPATH_COMPOSE_DIR=../CEREPATH
CEREPATH_COMPOSE_FILE=docker-compose.yml
CEREPATH_BASE_URL=http://127.0.0.1:5173
CEREPATH_GITHUB_REPO=aakashsiwach/CEREPATH

# Monitoring
CHECK_INTERVAL_SECONDS=30
REQUEST_TIMEOUT_SECONDS=5
FAILURES_BEFORE_RESTART=3
RESTART_COOLDOWN_SECONDS=600
LOG_TAIL_LINES=100

# Safe defaults: observe only. If enabled, only allowlisted non-database services
# in an exited/dead state may be restarted. HTTP failures alone never trigger restart.
AUTO_RESTART_SERVICES=false
ALLOWED_RESTART_SERVICES=api,web,browser-agent,egress-proxy
EXPECTED_COMPOSE_SERVICES=db,egress-proxy,browser-agent,api,web

# Optional GitHub Actions monitoring; requires Actions: read on the token.
CI_MONITOR_ENABLED=false
# High-risk opt-in: only creates draft PRs, never merges/deploys.
AUTO_REPAIR_CI=false
# Comma-separated list of existing files the model is permitted to modify.
AUTO_REPAIR_FILES=

# Local incident history; keep outside the CEREPATH repository.
GUARDIAN_STATE_DIR=./data

# Optional OpenAI-compatible endpoint for diagnosis and patch proposals.
# Example local Ollama: http://127.0.0.1:11434/v1
# Example hosted endpoint: https://api.openai.com/v1
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Required only with --publish-pr. Use a fine-grained token scoped to CEREPATH:
# Contents: read/write; Pull requests: read/write; Metadata: read.
# Never reuse CEREPATH runtime secrets here.
GITHUB_TOKEN=
